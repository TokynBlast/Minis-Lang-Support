{
  "scopeName": "source.minis",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#preprocessor"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#modifiers"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#chars"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#classes"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.minis",
          "match": "//.*$"
        },
        {
          "name": "comment.block.minis",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "meta.preprocessor.macro.minis",
          "match": "^\\s*#def\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.function.preprocessor.minis" }
          }
        },
        {
          "name": "keyword.control.directive.conditional.minis",
          "match": "^\\s*#(if((n)def)|elif|endif)\\b"
        },
        {
          "name": "keyword.control.directive.pragma.minis",
          "match": "^\\s*#pragma\\b.*"
        },
        {
          "name": "keyword.control.directive.unroll.minis",
          "match": "^\\s*#unroll\\b.*"
        },
        {
          "name": "keyword.control.directive.error.minis",
          "match": "^\\s*#error\\b.*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.minis",
          "match": "\\b(elif|if|else|while|for|return|break|continue|exit|in|as|with|and|using|class|new|public|private|try|catch|finally|del|throw|when|extern)\\b"
        },
        {
          "name": "keyword.other.minis",
          "match": "\\b(constexpr|global)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.numeric.minis",
          "match": "\\b((u|i)(8|16|32|64|128|256|512)|int|float)\\b"
        },
        {
          "name": "storage.type.minis",
          "match": "\\b(str|bool|tribool|list|dict|void|auto|char|enum|struct|ptr)\\b"
        }
      ]
    },
    "modifiers": {
      "patterns": [
        {
          "name": "storage.modifier.minis",
          "match": "\\b(const|static|constexpr|inline|alwaysinline)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.minis",
          "match": "\\b(true|false|nil)\\b"
        },
        {
          "name": "constant.language.null.minis",
          "match": "\\bnull\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.minis",
          "begin": "f\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.minis",
              "match": "\\\\."
            },
            {
              "name": "constant.other.placeholder.minis",
              "match": "\\{\\}"
            }
          ]
        },
        {
          "name": "string.quoted.double.minis",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.minis",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "string.quoted.single.minis",
          "match": "'(\\\\.|[^'\\\\])'",
          "captures": {
            "1": { "name": "constant.character.minis" }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.minis",
          "match": "\\b0x[0-9A-Fa-f]+\\b"
        },
        {
          "name": "constant.numeric.binary.minis",
          "match": "\\b0b[01]+\\b"
        },
        {
          "name": "constant.numeric.float.minis",
          "match": "\\b-?\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.minis",
          "match": "\\b-?\\d+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.minis",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.minis",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.assignment.minis",
          "match": "(<<=|>>=|\\+=|-=|\\*=|/=|\\^=|=)"
        },
        {
          "name": "keyword.operator.arithmetic.minis",
          "match": "(<<|>>|\\+\\+|--|\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.other.minis",
          "match": "(->|\\.\\.|::|\\?|:)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.minis",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()"
        },
        {
          "name": "entity.name.function.method.minis",
          "match": "::([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.function.minis" }
          }
        }
      ]
    },
    "classes": {
      "patterns": [
        {
          "name": "entity.name.type.class.minis",
          "match": "\\b(class)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.minis" },
            "2": { "name": "entity.name.type.minis" }
          }
        },
        {
          "name": "entity.name.type.minis",
          "match": "\\b(new)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.minis" },
            "2": { "name": "entity.name.type.minis" }
          }
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.parenthesis.open.minis",
          "match": "\\("
        },
        {
          "name": "punctuation.parenthesis.close.minis",
          "match": "\\)"
        },
        {
          "name": "punctuation.brace.open.minis",
          "match": "\\{"
        },
        {
          "name": "punctuation.brace.close.minis",
          "match": "\\}"
        },
        {
          "name": "punctuation.bracket.open.minis",
          "match": "\\["
        },
        {
          "name": "punctuation.bracket.close.minis",
          "match": "\\]"
        },
        {
          "name": "punctuation.delimiter.minis",
          "match": "[,;:]"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.minis",
          "match": "\\b(print)\\s*(?=\\()",
          "captures": {
            "1": { "name": "support.function.print.minis" }
          }
        },
        {
          "name": "support.function.builtin.minis",
          "match": "\\b(exit)\\s*(?=\\()",
          "captures": {
            "1": { "name": "support.function.exit.minis" }
          }
        },
        {
          "name": "support.function.builtin.minis",
          "match": "\\b(println)\\s*(?=\\()",
          "captures": {
            "1": { "name": "support.function.println.minis" }
          }
        },
        {
          "name": "support.function.builtin.minis",
          "match": "\\b(clamp)\\s*(?=\\()",
          "captures": {
            "1": { "name": "support.function.clamp.minis" }
          }
        },
        {
          "name": "support.function.builtin.minis",
          "match": "\\b(sort)\\s*(?=\\()",
          "captures": {
            "1": { "name": "support.function.sort.minis" }
          }
        },
        {
          "name": "support.function.builtin.minis",
          "match": "\\b(isLetter)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "support.function.isLetter.minis"
            }
          }
        },
        {
          "name": "support.function.builtin.minis",
          "match": "\\b(isAlphaNumeric)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "support.function.isAlphaNumeric.minis"
            }
          }
        },
        {
          "name": "support.function.builtin.minis",
          "match": "\\b(isAlpha)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "support.function.isAlpha.minis"
            }
          }
        },
        {
          "name": "support.function.builtin.minis",
          "match": "\\b(isNumeric)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "support.function.isNumeric.minis"
            }
          }
        },
        {
          "name": "support.function.builtin.minis",
          "match": "\\b(flush)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "support.function.flush.minis"
            }
          }
        },
        {
          "name": "support.function.builtin.minis",
          "match": "\\b(flushln)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "support.function.flushln.minis"
            }
          }
        },
        {
          "name": "support.function.builtin.minis",
          "match": "\\b(writeln)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "support.function.writeln.minis"
            }
          }
        },
        {
          "name": "support.function.builtin.minis",
          "match": "\\b(write)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "support.function.write.minis"
            }
          }
        },
        {
          "name": "support.function.builtin.minis",
          "match": "\\b(max)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "support.function.max.minis"
            }
          }
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "comment": "Variable declaration with type annotation: type name = ...",
          "match": "\\b((u|i)(8|16|32|64|128|256|512)|int|float|str|bool|tribool|list|dict|void|auto|ptr|char)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?==|;|,)",
          "captures": {
            "1": { "name": "storage.type.minis" },
            "4": { "name": "variable.other.minis" }
          }
        },
        {
          "comment": "Variable declaration with modifiers: const/static type name",
          "match": "\\b(const|static|constexpr|setonce)\\s+((u|i)(8|16|32|64|128|256|512)|int|float|str|bool|tribool|list|dict|void|auto|ptr|char)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.minis" },
            "2": { "name": "storage.type.minis" },
            "5": { "name": "variable.other.minis" }
          }
        }
      ]
    }
  },
  "uuid": "minis-highlight-003"
}
